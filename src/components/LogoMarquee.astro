---
interface Props {
  label?: string
}
const { label = 'Built with' } = Astro.props

interface Logo {
  src: string
  alt: string
  /**
   * Rendered height in px. Equal heights would not read as equal sizes: a 1:1
   * icon and a 4:1 wordmark drawn 44px tall differ by four times the ink. Each
   * height here is 44 / sqrt(aspect) of the mark's measured ink box, which
   * lands every logo on roughly the same drawn area. Two source files were
   * cropped to their ink (claude-code, cloudflare) so the ratio is honest.
   */
  h: number
  /**
   * Width in px at that height, i.e. h times the file's own aspect ratio.
   * Stated rather than inferred so the boxes are sized before the lazy SVGs
   * arrive: nothing reflows, and the belt's loop length is right on frame one.
   */
  w: number
}

const logos: Logo[] = [
  { src: '/logos/claude-code.svg', alt: 'Claude Code', h: 35, w: 56 },
  { src: '/logos/ts-logo-512.svg', alt: 'TypeScript', h: 44, w: 44 },
  { src: '/logos/Svelte_Logo.svg', alt: 'Svelte', h: 48, w: 40 },
  { src: '/logos/tailwind.svg', alt: 'Tailwind CSS', h: 34, w: 56 },
  { src: '/logos/docker-svgrepo-com.svg', alt: 'Docker', h: 44, w: 44 },
  { src: '/logos/cloudflare-icon.svg', alt: 'Cloudflare', h: 30, w: 66 },
  { src: '/logos/hetzner-h.svg', alt: 'Hetzner', h: 44, w: 44 },
  // Drizzle's file carries its own padding, so the box is taller than the ink.
  { src: '/logos/drizzle-mono.svg', alt: 'Drizzle', h: 24, w: 128 },
  { src: '/logos/n8n.svg', alt: 'n8n', h: 31, w: 62 },
  { src: '/logos/better-auth.svg', alt: 'Better Auth', h: 22, w: 88 },
  { src: '/logos/git.svg', alt: 'Git', h: 44, w: 44 },
  { src: '/logos/github.svg', alt: 'GitHub', h: 44, w: 44 },
  { src: '/logos/supabase.svg', alt: 'Supabase', h: 45, w: 43 },
]
---
<section class="logo-marquee-wrap" aria-label={label}>
  <span class="logo-marquee-label">{label}</span>
  <div class="logo-marquee">
    <div class="logo-track" data-logo-track>
      {/*
        The second set is the animation's wrap-around copy, so it is hidden
        from assistive tech and shares its URLs with the first set: 26 tags
        only ever cost 13 requests. Those requests are deferred because the
        marquee sits well below the fold on the page that mounts it.
      */}
      {[0, 1].map((setIndex) => (
        <div class="logo-set" aria-hidden={setIndex === 1 ? 'true' : undefined}>
          {logos.map((logo) => (
            <span class="logo-item">
              <img
                src={logo.src}
                alt={logo.alt}
                width={logo.w}
                height={logo.h}
                style={`width:${logo.w}px;height:${logo.h}px`}
                loading="lazy"
                decoding="async"
              />
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .logo-marquee-wrap {
    margin-top: 3rem;
  }

  .logo-marquee-label {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  /*
   * The fade is clamped, not a share of the width: at 8% each side it ate 62px
   * of a 390px phone, which is half a logo at either end. It still has to grow
   * with the viewport, though — a 24px fade against a 66px logo on a desktop
   * reads as a hard cut rather than a belt running past the edge.
   */
  .logo-marquee {
    --fade: clamp(24px, 5vw, 80px);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black var(--fade), black calc(100% - var(--fade)), transparent);
    mask-image: linear-gradient(to right, transparent, black var(--fade), black calc(100% - var(--fade)), transparent);
  }

  .logo-track {
    display: flex;
    width: max-content;
    /*
     * The CSS keyframes are the no-JS and reduced-motion baseline. The script
     * below cancels them and drives the same movement from rAF so page-scroll
     * velocity can push the speed around.
     */
    animation: logo-scroll 25s linear infinite;
  }

  .logo-set {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 2.75rem;
    padding-right: 2.75rem;
  }

  .logo-item {
    flex: 0 0 auto;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-item img {
    width: auto;
    max-width: none;
    object-fit: contain;
  }

  @keyframes logo-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /*
   * Stopped, the track shows the first set from its start; the wrap-around
   * copy simply never comes into view.
   */
  @media (prefers-reduced-motion: reduce) {
    .logo-track {
      animation: none;
    }
  }
</style>

<script>
  /*
   * Scroll-reactive marquee. The belt itself is a Web Animations API loop, so
   * the movement lives on the compositor; scroll velocity only nudges its
   * playbackRate. That split matters here, because the main thread is busiest
   * during exactly the gesture this reacts to: a rAF that wrote transforms by
   * hand would stutter under the same scroll that is meant to speed it up.
   *
   * The boost eases in fast and releases slowly, so letting go of the wheel
   * coasts the belt down instead of snapping it back to idle.
   */
  // Time for one full set: ~53px/s, a shade under the belt's old pace. Keep it
  // in step with the CSS keyframe duration above, which is the no-JS baseline.
  const SECONDS_PER_SET = 25
  const GAIN = 0.008 // extra playback rate per px/s of page scroll
  const MAX_BOOST = 16 // rate ceiling, so a flick cannot smear the logos
  const TARGET_DECAY = 6 // how fast the scroll reading falls off once events stop
  const ATTACK = 9 // ramp toward a rising boost
  const RELEASE = 1.7 // ramp back down: slower, this is the coast
  const SETTLED = 0.01 // below this the boost is invisible, so stop the loop

  const setupMarquee = (track: HTMLElement) => {
    // Reduced motion keeps the CSS baseline, which is already `animation: none`.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    // Hand over from the CSS keyframes immediately, not at first intersection:
    // the marquee sits below the fold, so waiting would let them wind the belt
    // forward and then snap it back to zero on takeover.
    track.style.animation = 'none'
    const belt = track.animate(
      [{ transform: 'translate3d(0, 0, 0)' }, { transform: 'translate3d(-50%, 0, 0)' }],
      { duration: SECONDS_PER_SET * 1000, iterations: Infinity, easing: 'linear' },
    )

    let frame = 0
    let onScreen = false
    let running = false
    let boost = 0
    let target = 0
    let last = 0
    let lastScrollY = window.scrollY
    let lastScrollAt = performance.now()

    const step = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05)
      last = now

      // No scroll events means no fresh reading, so the target bleeds off.
      target *= Math.exp(-TARGET_DECAY * dt)
      boost += (target - boost) * (1 - Math.exp(-(target > boost ? ATTACK : RELEASE) * dt))

      if (boost > SETTLED || target > SETTLED) {
        belt.playbackRate = 1 + boost
        frame = requestAnimationFrame(step)
      } else {
        // Settled: park it exactly on idle and hand the belt back to the
        // compositor. A marquee nobody is pushing costs no main-thread work.
        boost = 0
        belt.playbackRate = 1
        frame = 0
      }
    }

    const drive = () => {
      if (frame || !running) return
      last = performance.now()
      frame = requestAnimationFrame(step)
    }

    const onScroll = () => {
      const now = performance.now()
      const travelled = Math.abs(window.scrollY - lastScrollY)
      const since = lastScrollAt
      lastScrollY = window.scrollY
      lastScrollAt = now
      // Off-screen the belt is parked, so keep the reading current without
      // waking the loop; resuming on a stale delta would fire a phantom burst.
      if (!running) return
      // Floor the interval: two scroll events in the same millisecond would
      // otherwise divide out to an absurd velocity.
      const dt = Math.max(now - since, 8) / 1000
      target = Math.min((travelled / dt) * GAIN, MAX_BOOST)
      drive()
    }
    window.addEventListener('scroll', onScroll, { passive: true })

    // Intersection and tab visibility are tracked apart, then reconciled: a tab
    // switch fires no intersection change, so folding them into one flag would
    // leave the belt parked for good after the user comes back.
    const sync = () => {
      const next = onScreen && !document.hidden
      if (next === running) return
      running = next
      if (running) {
        belt.play()
        drive()
      } else {
        belt.pause()
        cancelAnimationFrame(frame)
        frame = 0
        boost = 0
        target = 0
        belt.playbackRate = 1
      }
    }

    // Off-screen or on a hidden tab the belt is pure waste, and pausing rather
    // than letting it run blind also spares the jump-cut on tab return.
    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting
        sync()
      },
      { rootMargin: '100px' },
    ).observe(track)

    document.addEventListener('visibilitychange', sync)
  }

  document
    .querySelectorAll<HTMLElement>('[data-logo-track]')
    .forEach(setupMarquee)
</script>
