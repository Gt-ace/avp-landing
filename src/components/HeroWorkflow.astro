---
import { artifacts, connections } from './hero-workflow/workflow-model'

const resolvedSteps = [
  { title: 'Request', detail: 'Captured once' },
  { title: 'Check', detail: 'Details complete' },
  { title: 'Approve', detail: 'Decision visible' },
  { title: 'Sync', detail: 'Systems updated' },
  { title: 'Done', detail: 'Work moves on' },
]
---

<div class="workflow" data-workflow-root>
  <span class="workflow-example-label" id="workflow-example-label">
    Example workflow
  </span>
  <span class="visually-hidden" id="workflow-resolved-label">
    Resolved workflow
  </span>

  <ol
    class="workflow-fallback"
    aria-labelledby="workflow-example-label workflow-resolved-label"
  >
    {resolvedSteps.map((step) => <li>{step.title}</li>)}
  </ol>

  <div class="workflow-scene" data-workflow-scene aria-hidden="true">
    <svg
      class="workflow-lines"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {connections.map((connection) => (
        <line
          data-connection={connection.id}
          data-connection-phase={connection.phase}
        />
      ))}
      <line data-process-tail />
    </svg>

    <ol class="workflow-artifacts">
      {artifacts.map((artifact) => (
        <li
          class="workflow-artifact"
          data-artifact={artifact.id}
          data-role={artifact.role}
        >
          <article class="artifact-surface">
            <header class="artifact-header">
              <span class:list={['artifact-icon', `artifact-icon--${artifact.icon}`]}>
                {artifact.icon === 'mail' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6.5h16v11H4z M4.5 7l7.5 6 7.5-6" />
                  </svg>
                )}
                {artifact.icon === 'sheet' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 3.5h14v17H5z M5 9h14 M10 9v11 M15 9v11 M5 14h14" />
                  </svg>
                )}
                {artifact.icon === 'approval' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 3.5h10v4H7z M5 6h14v14H5z M8 14l2.5 2.5L16 11" />
                  </svg>
                )}
                {artifact.icon === 'reminder' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 17h12 M8 17V11a4 4 0 018 0v6 M10 20h4" />
                  </svg>
                )}
                {artifact.icon === 'accounting' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6h16v13H4z M7 10h4 M7 14h2 M14 10h3 M14 14h3" />
                  </svg>
                )}
              </span>
              <span class="artifact-title">{artifact.title}</span>
              {artifact.role === 'blocked' && (
                <span class="artifact-status">Waiting</span>
              )}
              {artifact.id === 'system' && (
                <span class="system-state">Live workflow</span>
              )}
            </header>

            {artifact.id === 'system' ? (
              <div class="system-content">
                <div class="system-heading">
                  <span>One clear path</span>
                  <strong>A working system</strong>
                </div>
                <ol class="system-sequence">
                  {resolvedSteps.map((step, index) => (
                    <li>
                      <span class="system-step-num">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <strong>{step.title}</strong>
                      <small>{step.detail}</small>
                    </li>
                  ))}
                </ol>
                <p class="system-foot">
                  The handoff is visible. The next step is already waiting.
                </p>
              </div>
            ) : artifact.id === 'sheet' ? (
              <div class="sheet-grid">
                {artifact.content.map((field) => (
                  <div class="sheet-cell">
                    <span>{field.label}</span>
                    <strong>{field.value || '\u00a0'}</strong>
                  </div>
                ))}
              </div>
            ) : (
              <dl class="artifact-content">
                {artifact.content.map((field) => (
                  <div class:list={['artifact-row', {
                    'artifact-row--message': field.label === 'Message',
                    'artifact-row--attachment': field.label === 'Attachment',
                    'artifact-row--note': field.label === 'Note',
                  }]}>
                    <dt>{field.label}</dt>
                    <dd>{field.value || '\u00a0'}</dd>
                  </div>
                ))}
              </dl>
            )}
          </article>

          {artifact.annotation && (
            <span class="workflow-annotation">{artifact.annotation}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  import { setupWorkflow } from './hero-workflow/workflow-controller'

  const cleanups = new Map<HTMLElement, () => void>()

  function cleanupWorkflows() {
    cleanups.forEach((cleanup) => cleanup())
    cleanups.clear()
  }

  function armWorkflow() {
    document
      .querySelectorAll<HTMLElement>('[data-workflow-root]')
      .forEach((root) => {
        cleanups.get(root)?.()
        try {
          cleanups.set(root, setupWorkflow(root))
        } catch {
          delete root.dataset.ready
          delete root.dataset.enhanced
        }
      })
  }

  armWorkflow()
  document.addEventListener('astro:before-swap', cleanupWorkflows)
  document.addEventListener('astro:page-load', armWorkflow)
</script>

<style>
  .workflow,
  .workflow-scene {
    position: absolute;
    inset: 0;
  }

  .workflow {
    --cobalt-progress: 1;
    --annotation-opacity: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    font-family: var(--font-body);
  }

  .visually-hidden,
  .workflow-fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .workflow-example-label {
    position: absolute;
    top: clamp(5.5rem, 8vh, 7rem);
    right: max(clamp(1.5rem, 4vw, 4rem), env(safe-area-inset-right));
    z-index: 7;
    padding: 0.5rem 0.65rem;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-ink);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    opacity: var(--hero-copy-opacity, 1);
    text-transform: uppercase;
  }

  .workflow-scene {
    overflow: hidden;
    pointer-events: auto;
  }

  .workflow-scene::before {
    position: absolute;
    top: 4%;
    right: 2%;
    bottom: 4%;
    left: 46%;
    z-index: 0;
    background: var(--color-cobalt);
    content: '';
    transform: scaleX(var(--cobalt-progress));
    transform-origin: right center;
    will-change: transform;
  }

  .workflow-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  .workflow-lines line {
    stroke: color-mix(in srgb, var(--color-ink) 58%, transparent);
    stroke-width: 0.45;
    stroke-dasharray: 1.2 1.2;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }

  .workflow-lines line[data-connection-phase='resolved'] {
    display: none;
  }

  .workflow-lines line[data-process-tail] {
    stroke: var(--color-paper);
    stroke-dasharray: none;
  }

  .workflow-artifacts {
    position: absolute;
    inset: 0;
    z-index: 2;
    list-style: none;
  }

  .workflow-artifact {
    --artifact-x: 0px;
    --artifact-y: 0px;
    --artifact-rotation: 0deg;
    --artifact-scale: 1;
    --artifact-opacity: 1;
    --annotation-opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    opacity: var(--artifact-opacity);
    transform:
      translate3d(
        var(--artifact-x),
        calc(var(--artifact-y) + var(--artifact-y-offset, 0px)),
        0
      )
      translate(-50%, -50%)
      rotate(var(--artifact-rotation))
      scale(var(--artifact-scale));
    transform-origin: center;
    will-change: transform, opacity;
  }

  .workflow:not([data-enhanced='true']) .workflow-artifact:not([data-artifact='system']) {
    display: none;
  }

  .workflow:not([data-enhanced='true']) .workflow-artifact[data-artifact='system'] {
    top: 52%;
    left: 68%;
  }

  .workflow-artifact[data-artifact='email'] {
    z-index: 2;
    width: min(34rem, 40vw);
  }

  .workflow-artifact[data-artifact='sheet'] {
    z-index: 3;
    width: min(29rem, 34vw);
  }

  .workflow-artifact[data-artifact='approval'] {
    z-index: 4;
    width: min(22rem, 27vw);
  }

  .workflow-artifact[data-artifact='reminder'] {
    z-index: 5;
    width: min(19rem, 23vw);
  }

  .workflow-artifact[data-artifact='system'] {
    z-index: 6;
    width: min(49rem, 56vw);
  }

  .artifact-surface {
    padding: 1.25rem;
    border: 1px solid var(--color-ink);
    border-radius: 0.2rem;
    background: var(--color-paper);
    box-shadow: 0.55rem 0.65rem 1.6rem rgb(17 19 21 / 15%);
    color: var(--color-ink);
  }

  .artifact-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 28%, transparent);
  }

  .artifact-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    background: var(--color-cobalt);
    color: var(--color-paper);
  }

  .artifact-icon--approval {
    background: var(--color-coral);
    color: var(--color-ink);
  }

  .artifact-icon--reminder {
    background: var(--color-highlight);
    color: var(--color-ink);
  }

  .artifact-icon--accounting {
    background: var(--color-ink);
  }

  .artifact-icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .artifact-title,
  .artifact-status,
  .system-state,
  .artifact-row dt,
  .sheet-cell span {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .artifact-status,
  .system-state {
    margin-left: auto;
    padding: 0.3rem 0.4rem;
  }

  .artifact-status {
    background: var(--color-coral);
  }

  .system-state {
    background: var(--color-highlight);
  }

  .artifact-content {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.8rem;
  }

  .artifact-row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: baseline;
  }

  .artifact-row dd {
    min-width: 0;
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .artifact-row--message {
    display: block;
    padding-top: 0.45rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .artifact-row--message dd {
    padding-top: 0.35rem;
    font-size: 0.9rem;
    white-space: normal;
  }

  .artifact-row--attachment dd {
    display: inline-block;
    width: max-content;
    padding: 0.2rem 0.35rem;
    box-shadow: 0 0 0 1px currentColor;
    font-size: 0.68rem;
  }

  .artifact-row--note dd {
    width: max-content;
    padding: 0.15rem 0.3rem 0.05rem;
    box-shadow: inset 0 -0.8em 0 var(--color-highlight);
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 600;
  }

  .sheet-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 0.9rem;
    border-top: 1px solid var(--color-ink);
    border-left: 1px solid var(--color-ink);
  }

  .sheet-cell {
    min-width: 0;
    min-height: 4rem;
    border-right: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
  }

  .sheet-cell span,
  .sheet-cell strong {
    display: block;
    padding: 0.45rem;
  }

  .sheet-cell span {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  .sheet-cell strong {
    overflow: hidden;
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .workflow-annotation {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 50%;
    width: max-content;
    padding: 0.42rem 0.55rem;
    background: var(--color-highlight);
    color: var(--color-ink);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    opacity: var(--annotation-opacity);
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .workflow-artifact[data-artifact='approval'] .workflow-annotation {
    background: var(--color-coral);
  }

  .workflow-artifact[data-emphasized='true'] .artifact-surface {
    outline: 2px solid var(--color-cobalt);
    outline-offset: 0.25rem;
  }

  .workflow-artifact[data-artifact='system'] .artifact-surface {
    min-height: 25rem;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border-color: var(--color-ink);
    box-shadow: 0.8rem 0.9rem 2rem rgb(8 22 70 / 24%);
  }

  .system-content {
    padding-top: clamp(1.5rem, 3vh, 2.5rem);
  }

  .system-heading span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--color-muted);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .system-heading strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 0.95;
  }

  .system-sequence {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(2rem, 5vh, 3.5rem);
    list-style: none;
    border-top: 1px solid var(--color-ink);
  }

  .system-sequence li {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 7.5rem;
    align-content: space-between;
    gap: 0.4rem;
    padding: 0.75rem 0.65rem;
    border-right: 1px solid var(--color-ink);
  }

  .system-sequence li:first-child {
    border-left: 1px solid var(--color-ink);
  }

  .system-sequence li::before {
    position: absolute;
    top: -0.28rem;
    left: 0.65rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-cobalt);
    content: '';
  }

  .system-sequence li:last-child::before {
    background: var(--color-highlight);
    box-shadow: 0 0 0 1px var(--color-ink);
  }

  .system-step-num {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .system-sequence strong {
    align-self: end;
    font-size: 0.9rem;
  }

  .system-sequence small {
    color: var(--color-muted);
    font-size: 0.68rem;
    line-height: 1.3;
  }

  .system-foot {
    max-width: 34ch;
    margin-top: 1.2rem;
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  @media (max-width: 899px) {
    .workflow-scene::before {
      left: 39%;
    }

    .workflow-artifact[data-artifact='email'] {
      width: min(30rem, 51vw);
    }

    .workflow-artifact[data-artifact='sheet'] {
      width: min(26rem, 46vw);
    }

    .workflow-artifact[data-artifact='approval'] {
      width: min(20rem, 38vw);
    }

    .workflow-artifact[data-artifact='system'] {
      width: min(43rem, 68vw);
    }
  }

  @media (max-width: 767px) {
    .workflow-example-label {
      top: clamp(23.5rem, 58%, 30rem);
      right: auto;
      left: 1.5rem;
    }

    .workflow-scene::before {
      top: 49%;
      right: 1rem;
      bottom: 2.5%;
      left: 1rem;
      transform: scaleY(var(--cobalt-progress));
      transform-origin: bottom center;
    }

    .workflow-artifact[data-artifact='email'] {
      width: min(22rem, 88vw);
    }

    .workflow-artifact[data-artifact='sheet'] {
      width: min(21rem, 86vw);
    }

    .workflow-artifact[data-artifact='approval'] {
      width: min(19rem, 80vw);
    }

    .workflow-artifact[data-artifact='reminder'] {
      width: min(17rem, 72vw);
    }

    .workflow-artifact[data-artifact='system'] {
      width: min(23rem, 88vw);
    }

    .workflow:not([data-enhanced='true']) .workflow-artifact[data-artifact='system'] {
      top: 79%;
      left: 50%;
    }

    .artifact-surface {
      padding: 0.9rem;
    }

    .workflow-artifact[data-artifact='system'] .artifact-surface {
      min-height: 19rem;
      padding: 1rem;
    }

    .system-content {
      padding-top: 1rem;
    }

    .system-heading strong {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }

    .system-sequence {
      grid-template-columns: 1fr;
      margin-top: 1.3rem;
      border-top: 0;
      border-left: 1px solid var(--color-ink);
    }

    .system-sequence li {
      grid-template-columns: 2rem 5rem 1fr;
      min-height: 0;
      align-items: center;
      padding: 0.42rem 0.6rem;
      border-top: 1px solid var(--color-ink);
      border-right: 1px solid var(--color-ink);
    }

    .system-sequence li:first-child {
      border-left: 0;
    }

    .system-sequence li::before {
      top: 50%;
      left: -0.28rem;
      transform: translateY(-50%);
    }

    .system-foot {
      display: none;
    }

    .artifact-row dd {
      font-size: 0.7rem;
    }

    .workflow-annotation {
      top: auto;
      right: 0;
      bottom: -0.55rem;
      left: auto;
      font-size: 0.55rem;
      transform: none;
    }
  }

  @media (min-width: 480px) and (max-width: 767px) {
    .workflow-example-label {
      top: 53%;
    }

    .workflow-scene::before {
      top: 35%;
    }

    .workflow[data-enhanced='true'] .workflow-artifact[data-artifact='system'] {
      --artifact-y-offset: -4rem;
    }
  }

  @media (max-width: 360px) {
    .workflow-example-label {
      top: clamp(23.5rem, 66%, 25rem);
      left: 1rem;
    }

    .workflow-artifact[data-artifact='email'],
    .workflow-artifact[data-artifact='sheet'] {
      --artifact-y-offset: 5rem;
    }

    .workflow-artifact[data-artifact='system'] .artifact-surface {
      min-height: 17rem;
    }

    .system-heading strong {
      font-size: 1.9rem;
    }

    .system-sequence li {
      grid-template-columns: 1.7rem 4.25rem 1fr;
      padding-block: 0.32rem;
    }
  }

  @media (max-width: 360px) and (max-height: 650px) {
    .workflow-scene::before {
      top: 26%;
    }

    .workflow[data-enhanced='true'] .workflow-artifact[data-artifact='system'] {
      --artifact-y-offset: -6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .workflow-artifact,
    .workflow-scene::before {
      will-change: auto;
    }
  }
</style>
