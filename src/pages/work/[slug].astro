---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { projects } from '../../data/projects'
import { fade } from 'astro:transitions'

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const project = projects.find((p) => p.slug === slug)

if (!project) {
  return Astro.redirect('/work')
}

const morph = fade({ duration: 300 })

// The gallery used to pad a single-image project out to three copies of that
// one image "for visual richness". It bought no information and cost a phone
// three decodes of a desktop-sized asset, so the page now renders exactly what
// the project declares. A project that wants three screenshots lists three.

// Video tier selection for the showcase video below. `media` on `<source>` left
// the HTML spec in 2014 and only Safari still honours it, so Chrome and Firefox
// ignored the old min-width queries and phones downloaded the 5.9MB desktop
// encode. The markup now ships the mobile encode to everyone and this upgrades a
// wide viewport, keeping the same 768px breakpoint as DESKTOP_VIDEO_QUERY in
// `src/components/work-card-stack/WorkProjectCard.tsx`.
//
// Carried as a string through `set:html` because an `is:inline` script's body is
// raw text: written as JSX children the surrounding backticks ship literally and
// the whole block is a syntax error.
const videoTierScript = `(function () {
  var upgrade = function () {
    var video = document.querySelector('[data-detail-video]')
    // The tier marker also makes this idempotent, which matters because the
    // view-transition swap can re-run this script against the same element.
    if (!video || video.dataset.videoTier) return
    if (!window.matchMedia('(min-width: 768px)').matches) {
      video.dataset.videoTier = 'mobile'
      return
    }

    var sources = []
    if (video.dataset.desktopWebm) sources.push([video.dataset.desktopWebm, 'video/webm'])
    if (video.dataset.desktopMp4) sources.push([video.dataset.desktopMp4, 'video/mp4'])
    if (!sources.length) return

    video.textContent = ''
    sources.forEach(function (pair) {
      var source = document.createElement('source')
      source.src = pair[0]
      source.type = pair[1]
      video.appendChild(source)
    })
    video.dataset.videoTier = 'desktop'
    // load() resets the element, and with it the autoplay the attribute would
    // have granted, so playback is re-asked for. Muted, so it stays allowed.
    video.load()
    video.play().catch(function () {})
  }

  upgrade()
  // /work morphs into this page through the view-transition router, which swaps
  // the body instead of loading a document, so a swapped-in video needs this too.
  if (!window.__avpDetailVideoTierHooked) {
    window.__avpDetailVideoTierHooked = true
    document.addEventListener('astro:page-load', upgrade)
  }
})()`
---
<BaseLayout title={`${project.title} | AVP Software`}>
  <div class="detail-layout">
    <aside class="detail-left">
      {/*
        The nav pill was the only route off this page, and on touch it is small
        and easy to miss, so a detail page read as a dead end on a phone. This
        sits at the top of the flow, below the fixed pill, at every width.
      */}
      <a
        href="/work"
        class="detail-back label"
        data-transition-direction="back"
      >&#8592; All work</a>

      <span class="label">{project.client}</span>

      <h1
        class="detail-title"
        transition:name={`title-${project.slug}`}
        transition:animate={morph}
      >
        {project.title}
      </h1>

      <p class="detail-desc">{project.description}</p>

      <div class="detail-tech">
        <span class="label">Built with</span>
        <span class="detail-tech-list">{project.tech.join(', ')}</span>
      </div>

      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="detail-visit label"
      >
        Visit project &#8599;
      </a>

      <div class="detail-credits">
        <span class="label">Credits</span>
        <dl class="credits-list">
          {Object.entries(project.credits).map(([role, name]) => (
            <>
              <dt>{role}</dt>
              <dd>{name}</dd>
            </>
          ))}
        </dl>
      </div>
    </aside>

    <div class="detail-right">
      {project.video && (
        <Fragment>
          {/*
            The markup ships the mobile encode to every client. `media` on
            <source> left the HTML spec in 2014, so Chrome and Firefox ignored
            the old min-width queries and phones downloaded the desktop file.
            The script below upgrades a wide viewport, and it is `is:inline` on
            purpose: a bundled script is deferred, so `autoplay` would already
            be pulling the mobile body and desktop would pay for both files.
          */}
          <video
            class="detail-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={project.video.poster}
            data-detail-video
            data-desktop-webm={project.video.desktopWebm}
            data-desktop-mp4={project.video.desktopMp4}
          >
            {project.video.mobileWebm && (
              <source src={project.video.mobileWebm} type="video/webm" />
            )}
            <source src={project.video.mobileMp4} type="video/mp4" />
          </video>
          <script is:inline set:html={videoTierScript} />
        </Fragment>
      )}
      {project.images.map((src, i) => (
        <img
          src={src}
          alt={project.title}
          loading={i === 0 ? 'eager' : 'lazy'}
          class={src.includes('-mobile') ? 'detail-image-mobile' : undefined}
          transition:name={i === 0 && !project.video ? `image-${project.slug}` : undefined}
          transition:animate={i === 0 && !project.video ? morph : undefined}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .detail-layout {
    display: grid;
    grid-template-columns: 2fr 3fr;
    min-height: 100dvh;
  }

  .detail-left {
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow-y: auto;
    padding: clamp(8rem, 15vh, 12rem) clamp(2rem, 5vw, 5rem) 4rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .detail-back {
    /* inline-flex, not inline-block: the label is one short line, so only a
       box with its own height clears the 44px touch target. */
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 44px;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    transition: opacity 200ms, color 200ms;
  }

  .detail-back:hover {
    color: var(--color-ink);
    opacity: 0.6;
  }

  .detail-back:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  .detail-title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 600;
    font-optical-sizing: none;
    color: var(--color-ink);
    line-height: 1.1;
    text-wrap: balance;
    margin-top: 0.5rem;
  }

  .detail-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-muted);
    max-width: 44ch;
    margin-top: 1.5rem;
    line-height: 1.6;
  }

  .detail-tech {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .detail-tech-list {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
  }

  .detail-visit {
    display: inline-block;
    color: var(--color-ink);
    margin-top: 2rem;
    transition: opacity 200ms;
  }

  .detail-visit:hover {
    opacity: 0.6;
  }

  .detail-credits {
    margin-top: auto;
    padding-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .credits-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 1rem;
    list-style: none;
    margin-top: 0.5rem;
  }

  .credits-list dt {
    font-family: var(--font-body);
    font-size: var(--text-label);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .credits-list dd {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
  }

  .detail-right {
    /* Clear the fixed nav pill (top: 20px + 40px tall) so the leading
       image/video doesn't slide underneath it. */
    padding-top: clamp(5rem, 10vh, 7rem);
  }

  .detail-right img,
  .detail-right .detail-video {
    width: 100%;
    display: block;
  }

  .detail-video {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-ink);
  }

  .detail-image-mobile {
    width: min(280px, 50%);
    margin: 3rem auto;
  }

  @media (max-width: 767px) {
    .detail-layout {
      grid-template-columns: 1fr;
    }

    .detail-left {
      position: static;
      height: auto;
      padding: 8rem 1.25rem 3rem;
    }

    .detail-right {
      /* Left column already clears the nav and sits above us on mobile. */
      padding-top: 0;
    }

    .detail-credits {
      margin-top: 3rem;
    }

    .credits-list {
      /* Two columns put an uppercase letterspaced role and its name into half
         of a 320px screen, and both wrap to ragged fragments. Stacked, the
         pair reads as the definition list it already is. */
      grid-template-columns: 1fr;
      gap: 0.15rem 0;
    }

    .credits-list dt:not(:first-of-type) {
      /* The row gap is gone, so the pairs need their own separation. */
      margin-top: 0.75rem;
    }

    .detail-image-mobile {
      /* min(280px, 50%) painted this at 195px on a 390px screen: the one asset
         that is about phones, rendered smallest on a phone. */
      width: min(360px, 86%);
      margin: 2rem auto;
    }
  }
</style>
