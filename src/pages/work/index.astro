---
import BaseLayout from '../../layouts/BaseLayout.astro'
import WorkCardStack from '../../components/WorkCardStack'
import { toWorkCards } from '../../components/work-card-stack/work-card-model'
import { projects } from '../../data/projects'

const cards = toWorkCards(projects)
---

<BaseLayout title="Work | AVP Software">
  <main class="work-page">
    <WorkCardStack cards={cards} client:load />
  </main>
</BaseLayout>

<style is:global>
  ::view-transition-group(*) {
    animation-duration: 480ms;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /*
   * The island renders the list layout on the server so no-JS visitors get a
   * usable page. When JS can take over, keep that markup reserved but unpainted
   * until the island has picked its layout, otherwise the list flashes before
   * the stack pins.
   */
  html.js .work-stack {
    transition: opacity 200ms ease-out;
  }

  html.js .work-stack:not([data-work-stack-ready]) {
    visibility: hidden;
    opacity: 0;
  }
</style>
