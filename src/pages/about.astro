---
import BaseLayout from '../layouts/BaseLayout.astro'
import LogoMarquee from '../components/LogoMarquee.astro'
---
<BaseLayout title="About | AVP Software">
  <main class="page-container">
    <span class="page-label">About</span>
    <h1 class="page-heading">Arthur Van Petegem</h1>
    <div class="page-body">
      <p>
        Arthur Van Petegem is a software engineer and builder based in St. Gallen and Baden, Aargau.
        He builds precise, opinionated software, from volunteer coordination platforms
        to automating operations processes.
      </p>
      <p>
        AVP Software is the studio through which that work ships. The focus is on
        craft over convention: software that is fast, considered, and owned by the
        people who use it.
      </p>
    </div>

    <div class="about-focus">
      <span class="label">Focus</span>
      <ul>
        <li>Web platforms</li>
        <li>Process automations</li>
        <li>AI-assisted products</li>
      </ul>
    </div>
  </main>
  <LogoMarquee />
</BaseLayout>

<style>
  /*
   * One heading for the list, not one per row: the word was the same on all
   * three and its fixed 4rem column plus the gap spent 88px of a phone's
   * width repeating it.
   */
  .about-focus {
    margin-top: 2.5rem;
  }

  .about-focus .label {
    display: block;
    margin-bottom: 0.75rem;
  }

  .about-focus ul {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .about-focus li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
  }
</style>
