---
import NavPill from '../components/NavPill'
import '../styles/global.css'
import { ViewTransitions } from 'astro:transitions'

export interface Props {
  title?: string
  description?: string
}
const {
  title = 'AVP Software',
  description = 'AVP Software: creative software studio',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og-image.png', Astro.site)
const staticNavLinks = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon-avp.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / link preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AVP Software" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AVP Software" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Bodoni is only ever set upright at 600, and every rule that uses it sets
      `font-optical-sizing: none`, which falls back to the family's default
      optical size of 11. Asking for that one instance instead of the italic
      plus both axis ranges takes the Latin file from 46K to 15K and the
      stylesheet from 7.6K to 3.9K.
    -->
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@11,600&family=Geist:wght@400..600&display=swap"
      rel="stylesheet"
    />

    <!-- Mark JS as available so scroll-reveal styles only hide content when JS can reveal it -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>

    <!--
      Astro's router hardcodes 'forward' for every link click; only the
      browser back/forward gesture produces 'back'. The detail page's
      "← All work" link is a same-site back affordance and wants the reverse
      slide too, so it opts in with data-transition-direction rather than
      this listener guessing at URL shape. astro:before-preparation fires
      synchronously (events.js dispatchEvent) before router.js reads
      event.direction to set data-astro-transition, so the override lands in
      time. document survives the swap, so one registration covers every
      navigation.
    -->
    <script is:inline>
      document.addEventListener('astro:before-preparation', (event) => {
        const forced = event.sourceElement?.dataset.transitionDirection
        if (forced) event.direction = forced
      })
    </script>

    <ViewTransitions />
  </head>
  <body>
    <div class="enhanced-nav">
      <NavPill client:load />
    </div>
    <nav class="static-primary-nav" aria-label="Primary navigation">
      {staticNavLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  /*
   * One timing for every view transition on the site. `(*)` covers `root` as
   * well as the named groups, so the page cross-fade and the /work card morph
   * run to the same clock: naming only the groups left the outgoing page gone
   * at the UA default 250ms while the morph still had 50ms to run.
   *
   * Astro only emits its own reduced-motion override on pages that use a
   * transition directive, and these durations are site-wide, so carry the
   * guard here rather than relying on that.
   */
  ::view-transition-group(*),
  ::view-transition-old(*),
  ::view-transition-new(*) {
    animation-duration: 300ms;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /*
   * Back is not the forward morph played backwards. The incoming /work
   * document is snapshotted before the card stack hydrates and pins, so a
   * morph would animate toward the un-pinned list geometry (see the comment
   * in WorkCardStack.tsx). This gets the feeling of reversal without it.
   *
   * The attribute has to be one Astro owns, and it has to start `data-astro-`.
   * `swapRootAttributes` (astro/dist/transitions/swap-functions.js) strips
   * every attribute off <html> during the swap and restores only the incoming
   * document's plus the ones whose name starts with `data-astro-`; that swap
   * runs inside the `startViewTransition` update callback, before the
   * pseudo-element tree is built. Any hand-rolled attribute is therefore gone
   * by the time these rules are matched, and back silently falls back to the
   * plain cross-fade. `data-astro-transition` is set to the literal
   * 'forward'/'back' in router.js immediately before the transition starts and
   * removed when it finishes, so it survives exactly as long as it is needed.
   *
   * Scoped by attribute so it outranks the (*) rule above regardless of source
   * order, and applied to `(*)` rather than `(root)` so every outgoing group
   * takes the same slide. /work/[slug] names its title and its hero image, and
   * naming lifts those elements out of the root snapshot; on the way back
   * nothing on the incoming /work document carries those names, so the groups
   * are unpaired and fall back to a plain fade. At `(root)` that left the
   * title and hero standing still while the page slid out from under them.
   *
   * The outgoing page runs 100ms shorter than the incoming one on purpose:
   * matched durations leave both pages half-transparent through the middle of
   * the swap, which reads as a smear rather than a reversal.
   */
  html[data-astro-transition='back']::view-transition-old(*) {
    animation: avp-back-out 200ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  html[data-astro-transition='back']::view-transition-new(*) {
    animation: avp-back-in 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes avp-back-out {
    to {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes avp-back-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }

  .static-primary-nav {
    position: fixed;
    z-index: 50;
    top: 1.25rem;
    left: 50%;
    display: flex;
    width: min(22rem, calc(100vw - 2rem));
    height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    transform: translateX(-50%);
    border: 1px solid oklch(85% 0.003 260 / 60%);
    border-radius: 9999px;
    background: oklch(98% 0.003 260 / 85%);
    backdrop-filter: blur(12px);
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .static-primary-nav a {
    color: var(--color-muted);
  }

  .static-primary-nav a:hover,
  .static-primary-nav a:focus-visible {
    color: var(--color-ink);
  }

  .static-primary-nav a:focus-visible {
    outline: 1px solid var(--color-ink);
    outline-offset: 0.25rem;
  }

  html.js .static-primary-nav {
    display: none;
  }

  html:not(.js) .enhanced-nav {
    display: none;
  }
</style>
