---
import NavPill from '../components/NavPill'
import '../styles/global.css'
import { ViewTransitions } from 'astro:transitions'

export interface Props {
  title?: string
  description?: string
}
const {
  title = 'AVP Software',
  description = 'AVP Software: creative software studio',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og-image.png', Astro.site)
const staticNavLinks = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon-avp.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / link preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AVP Software" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AVP Software" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Geist:wght@400..600&display=swap"
      rel="stylesheet"
    />

    <!-- Mark JS as available so scroll-reveal styles only hide content when JS can reveal it -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>

    <ViewTransitions />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="enhanced-nav">
      <NavPill client:load />
    </div>
    <nav class="static-primary-nav" aria-label="Primary navigation">
      {staticNavLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.65rem 0.85rem;
    transform: translateY(-200%);
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--color-coral);
    outline-offset: 0.25rem;
  }

  .static-primary-nav {
    position: fixed;
    z-index: 50;
    top: 1.25rem;
    left: 50%;
    display: flex;
    width: min(22rem, calc(100vw - 2rem));
    height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    transform: translateX(-50%);
    border: 1px solid oklch(85% 0.003 260 / 60%);
    border-radius: 9999px;
    background: oklch(98% 0.003 260 / 85%);
    backdrop-filter: blur(12px);
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .static-primary-nav a {
    color: var(--color-muted);
  }

  .static-primary-nav a:hover,
  .static-primary-nav a:focus-visible {
    color: var(--color-ink);
  }

  .static-primary-nav a:focus-visible {
    outline: 1px solid var(--color-ink);
    outline-offset: 0.25rem;
  }

  html.js .static-primary-nav {
    display: none;
  }

  html:not(.js) .enhanced-nav {
    display: none;
  }
</style>
